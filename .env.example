# Testbed API providers (run_agent.py --mode api --provider ...)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=120

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=120

# Optional provider; Testbed has no default API provider.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=120

# Testbed runtime controls
AGENT_SCHEMA_MAX_RETRIES=1
AGENT_WORKER_TIMEOUT_SECONDS=7200
POLICY_AGENT_DB_PATH=

# Auditor settings (separate from the Testbed Agent)
UPSTAGE_API_KEY=
UPSTAGE_BASE_URL=
AUDITOR_LLM_MODEL=
AUDITOR_LLM_ENABLED=true
